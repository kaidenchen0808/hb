# Companion Layer 配置
# 复制为 .env 后填写

# HTTP 服务端口（AniCompanion 指向 http://127.0.0.1:<PORT>）
PORT=8787

# 女友大脑：两种格式二选一
# A) OpenAI 兼容网关（LiteLLM / AI Hub / OpenRouter / GLM paas/v4 ...）
# BRAIN_API_FORMAT=openai
# BRAIN_BASE_URL=http://127.0.0.1:4000/v1
# B) Anthropic 兼容端点（GLM Coding Plan 的 anthropic 端点等）
# BRAIN_API_FORMAT=anthropic
# BRAIN_BASE_URL=https://open.bigmodel.cn/api/anthropic
BRAIN_API_FORMAT=openai
BRAIN_BASE_URL=
BRAIN_API_KEY=
BRAIN_MODEL=

# 可选：校验 /v1/chat/completions 与 /api/* 的 Bearer key（与 AniCompanion Settings 里填的一致）
# 留空则不校验
COMPANION_API_KEY=

# 数据库与人格文件路径（一般不用改）
DB_PATH=./data/companion.db
PERSONA_PATH=./persona/persona.yaml
